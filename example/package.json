{
  "name": "@sbaiahmed1/react-native-biometrics-example",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "cd android && ./gradlew assembleDebug -DtestBuildType=debug -Dorg.gradle.jvmargs=-Xmx4g",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/ReactNativeBiometricsExample.xcworkspace -UseNewBuildSystem=YES -scheme ReactNativeBiometricsExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "expo-dev-client": "~6.0.21",
    "react-native-builder-bob": "^0.40.12",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
