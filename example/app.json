{
  "expo": {
    "name": "ReactNativeBiometrics Example",
    "slug": "react-native-biometrics-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "sbaiahmed1.reactnativebiometrics.example",
      "supportsTablet": true,
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default",
                "UISceneDelegateClassName": "SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "package": "sbaiahmed1.reactnativebiometrics.example"
    },
    "plugins": [
      [
        "../app.plugin.js",
        {
          "faceIDPermission": "This app uses Face ID to demonstrate secure biometric authentication."
        }
      ],
      "./plugins/withSceneDelegate.js"
    ]
  }
}
