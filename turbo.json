{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml",
    "package.json",
    "*.podspec",
    "app.plugin.js",
    "android/**",
    "!android/build/**",
    "ios/**",
    "src/**",
    "plugin/src/**",
    "plugin/tsconfig.json"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "pipeline": {
    "build:android": {
      "env": [
        "ANDROID_HOME"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "babel.config.js",
        "metro.config.js",
        "index.js",
        "*.tsx",
        "src/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": [
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "app.json",
        "babel.config.js",
        "metro.config.js",
        "index.js",
        "*.tsx",
        "src/**"
      ],
      "outputs": []
    }
  }
}
